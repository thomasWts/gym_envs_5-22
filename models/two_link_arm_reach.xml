<mujoco model="two_link_arm_reach">
  <compiler angle="radian"/>

  <option timestep="0.002" gravity="0 0 0"/>

  <default>
    <joint damping="0.25" armature="0.02"/>
    <geom friction="1 0.005 0.0001" contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1"/>

    <geom
      name="table"
      type="plane"
      pos="0 0 -0.02"
      size="1.2 1.2 0.02"
      rgba="0.84 0.84 0.82 1"/>

    <geom
      name="workspace"
      type="cylinder"
      pos="0 0 0.0"
      size="0.82 0.004"
      rgba="0.18 0.18 0.18 0.18"
      contype="0"
      conaffinity="0"/>

    <site
      name="target_site"
      type="sphere"
      pos="0.45 0.25 0.08"
      size="0.035"
      rgba="0.05 0.85 0.25 1"/>

    <body name="base" pos="0 0 0.08">
      <geom
        name="base_geom"
        type="cylinder"
        size="0.08 0.04"
        rgba="0.14 0.14 0.16 1"/>

      <body name="upper_arm" pos="0 0 0">
        <joint
          name="shoulder"
          type="hinge"
          axis="0 0 1"
          limited="false"/>
        <geom
          name="upper_arm_geom"
          type="capsule"
          fromto="0 0 0 0.42 0 0"
          size="0.035"
          mass="0.5"
          rgba="0.20 0.45 1.0 1"/>

        <body name="forearm" pos="0.42 0 0">
          <joint
            name="elbow"
            type="hinge"
            axis="0 0 1"
            limited="false"/>
          <geom
            name="forearm_geom"
            type="capsule"
            fromto="0 0 0 0.36 0 0"
            size="0.030"
            mass="0.35"
            rgba="1.0 0.58 0.20 1"/>
          <site
            name="end_effector"
            type="sphere"
            pos="0.36 0 0"
            size="0.032"
            rgba="0.95 0.08 0.08 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor
      name="shoulder_motor"
      joint="shoulder"
      gear="1"
      ctrllimited="true"
      ctrlrange="-3 3"/>
    <motor
      name="elbow_motor"
      joint="elbow"
      gear="1"
      ctrllimited="true"
      ctrlrange="-3 3"/>
  </actuator>
</mujoco>
