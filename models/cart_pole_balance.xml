<mujoco model="cart_pole_balance">
  <compiler angle="degree"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.01"/>
    <geom friction="1 0.005 0.0001"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>

    <geom
      name="ground"
      type="plane"
      size="2 2 0.1"
      rgba="0.8 0.8 0.8 1"/>

    <geom
      name="rail"
      type="box"
      pos="0 0 0.55"
      size="1.0 0.015 0.015"
      rgba="0.2 0.2 0.2 1"
      contype="0"
      conaffinity="0"/>

    <body name="cart" pos="0 0 0.55">
      <joint
        name="cart_slide_x"
        type="slide"
        axis="1 0 0"
        limited="true"
        range="-1.8 1.8"
        damping="0.12"/>

      <geom
        name="cart_geom"
        type="box"
        size="0.10 0.06 0.04"
        mass="1.0"
        rgba="0.2 0.6 1 1"
        contype="0"
        conaffinity="0"/>

      <site
        name="pivot_site"
        pos="0 0 0"
        size="0.025"
        rgba="1 0 0 1"/>

      <body name="rod" pos="0 0 0">
        <joint
          name="rod_hinge_y"
          type="hinge"
          axis="0 1 0"
          damping="0.004"
          armature="0.001"/>

        <geom
          name="rod_geom"
          type="capsule"
          fromto="0 0 0  0 0 -0.40"
          size="0.015"
          mass="0.05"
          rgba="0.1 0.1 0.1 1"/>

        <geom
          name="ball_geom"
          type="sphere"
          pos="0 0 -0.40"
          size="0.045"
          mass="0.15"
          rgba="1 0.5 0 1"/>

        <site
          name="ball_site"
          pos="0 0 -0.40"
          size="0.025"
          rgba="0 1 0 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor
      name="cart_motor"
      joint="cart_slide_x"
      gear="1"
      ctrllimited="true"
      ctrlrange="-30 30"/>
  </actuator>
</mujoco>

