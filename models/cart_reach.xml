<mujoco model="cart_reach">
  <compiler angle="degree"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.05"/>
    <geom friction="1 0.005 0.0001"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>

    <geom
      name="ground"
      type="plane"
      size="2 2 0.1"
      rgba="0.82 0.82 0.82 1"/>

    <geom
      name="rail"
      type="box"
      pos="0 0 0.12"
      size="0.90 0.018 0.018"
      rgba="0.18 0.18 0.18 1"
      contype="0"
      conaffinity="0"/>

    <site
      name="target_site"
      type="sphere"
      pos="0.45 0 0.20"
      size="0.04"
      rgba="0.05 0.85 0.25 1"/>

    <body name="cart" pos="0 0 0.16">
      <joint
        name="cart_slide_x"
        type="slide"
        axis="1 0 0"
        limited="true"
        range="-0.85 0.85"
        damping="0.12"/>

      <geom
        name="cart_geom"
        type="box"
        size="0.08 0.055 0.04"
        mass="1.0"
        rgba="0.2 0.45 1 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor
      name="cart_motor"
      joint="cart_slide_x"
      gear="1"
      ctrllimited="true"
      ctrlrange="-10 10"/>
  </actuator>
</mujoco>

