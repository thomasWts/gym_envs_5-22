<mujoco model="block_reach_3d">
  <compiler angle="degree"/>

  <option timestep="0.002" gravity="0 0 0"/>

  <default>
    <joint damping="0.08"/>
    <geom friction="1 0.005 0.0001"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>

    <geom
      name="ground"
      type="plane"
      size="1.4 1.4 0.1"
      rgba="0.82 0.82 0.82 1"/>

    <geom
      name="x_axis"
      type="box"
      pos="0 0 0.02"
      size="0.85 0.005 0.005"
      rgba="0.9 0.15 0.15 1"
      contype="0"
      conaffinity="0"/>

    <geom
      name="y_axis"
      type="box"
      pos="0 0 0.025"
      size="0.005 0.85 0.005"
      rgba="0.15 0.55 0.95 1"
      contype="0"
      conaffinity="0"/>

    <site
      name="target_site"
      type="sphere"
      pos="0.35 0.25 0.45"
      size="0.045"
      rgba="0.05 0.85 0.25 1"/>

    <body name="block">
      <joint
        name="block_slide_x"
        type="slide"
        axis="1 0 0"
        limited="true"
        range="-0.8 0.8"
        damping="0.35"/>

      <joint
        name="block_slide_y"
        type="slide"
        axis="0 1 0"
        limited="true"
        range="-0.8 0.8"
        damping="0.35"/>

      <joint
        name="block_slide_z"
        type="slide"
        axis="0 0 1"
        limited="true"
        range="0.12 0.85"
        damping="0.35"/>

      <geom
        name="block_geom"
        type="box"
        size="0.055 0.055 0.055"
        mass="0.5"
        rgba="0.25 0.45 1 1"/>

      <site
        name="block_site"
        type="sphere"
        pos="0 0 0"
        size="0.018"
        rgba="1 1 1 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor
      name="block_motor_x"
      joint="block_slide_x"
      gear="1"
      ctrllimited="true"
      ctrlrange="-8 8"/>

    <motor
      name="block_motor_y"
      joint="block_slide_y"
      gear="1"
      ctrllimited="true"
      ctrlrange="-8 8"/>

    <motor
      name="block_motor_z"
      joint="block_slide_z"
      gear="1"
      ctrllimited="true"
      ctrlrange="-8 8"/>
  </actuator>
</mujoco>
